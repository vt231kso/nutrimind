generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER")

  // Поля Onboarding / Профілю
  gender        String?
  age           Int?
  height        Float?
  weight        Float?
  activityLevel Float?
  goal          String?

  // Цільові норми КБЖВ
  targetCalories Float?
  targetProteins Float?
  targetFats     Float?
  targetCarbs    Float?

  // Інтеграція з Telegram
  telegramChatId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Зв'язки NextAuth
  accounts Account[]
  sessions Session[]

  // Зв'язки NutriMind
  recipes        Recipe[]
  mealLogs       MealLog[]
  waterLogs      WaterLog[]
  weightLogs     WeightLog[]
  recipeRatings  RecipeRating[]
  recipeComments RecipeComment[]
  recipeLikes    RecipeLike[]
  aiUsages       AiUsage[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id              String  @id @default(uuid())
  name            String
  caloriesPer100g Float
  proteinsPer100g Float
  fatsPer100g     Float
  carbsPer100g    Float
  barcode         String? @unique

  // Зв'язки
  recipeIngredients RecipeIngredient[]
  mealLogItems      MealLogItem[]
}

model Recipe {
  id              String   @id @default(uuid())
  title           String
  description     String
  category        String?
  prepTimeMinutes Int?
  difficultyLevel String?
  isAiGenerated   Boolean  @default(false)
  isPublic        Boolean  @default(true)
  authorId        String
  createdAt       DateTime @default(now())

  // Зв'язки
  author       User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ingredients  RecipeIngredient[]
  steps        RecipeStep[]
  ratings      RecipeRating[]
  comments     RecipeComment[]
  likes        RecipeLike[]
  mealLogItems MealLogItem[]
}

model RecipeStep {
  id              String @id @default(uuid())
  recipeId        String
  stepNumber      Int
  instructionText String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model RecipeIngredient {
  id          String @id @default(uuid())
  recipeId    String
  productId   String
  amountGrams Float

  // Зв'язки
  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model MealLog {
  id            String   @id @default(uuid())
  userId        String
  date          DateTime
  mealType      String
  totalCalories Float    @default(0)

  // Зв'язки
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealLogItem[]
}

model MealLogItem {
  id                 String  @id @default(uuid())
  mealLogId          String
  productId          String?
  recipeId           String?
  customName         String
  weightGrams        Float
  calculatedCalories Float
  calculatedProteins Float
  calculatedFats     Float
  calculatedCarbs    Float

  // Зв'язки
  mealLog MealLog  @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  recipe  Recipe?  @relation(fields: [recipeId], references: [id])
}

model RecipeRating {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String
  value     Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model RecipeComment {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String
  text      String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model RecipeLike {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  amountMl  Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeightLog {
  id       String   @id @default(uuid())
  userId   String
  weightKg Float
  date     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiUsage {
  id               String   @id @default(uuid())
  userId           String
  endpoint         String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  timestamp        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
